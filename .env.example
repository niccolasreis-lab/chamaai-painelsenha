# Configurações Base
PORT=3001
NODE_ENV=development

# Configurações de Conexão com Supabase (Apenas Acesso Anônimo/Restrito)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ⚠️ AVISO DE SEGURANÇA ⚠️
# NUNCA coloque a SUPABASE_SERVICE_ROLE_KEY no aplicativo Electron distribuído.
# O aplicativo local de loja deve operar apenas com permissões restritas (via anon key ou autenticação por tenant).
# Qualquer operação administrativa privilegiada deve ser feita através de um backend cloud seguro (ex: Supabase Edge Functions).

# ==========================================
# INGESTÃO CLOUD (FASE 5)
# ==========================================
# Endpoint seguro para ativação de licença (Cloud Ingestion API)
CHAMAAI_CLOUD_ACTIVATE_URL=

# Endpoint seguro para check-in periódico (Cloud Ingestion API)
CHAMAAI_CLOUD_CHECKIN_URL=

# Timeout em ms para as chamadas à Edge Function
CHAMAAI_CLOUD_TIMEOUT_MS=10000

# Endpoint seguro para ingestão (Cloud Ingestion API)
CHAMAAI_CLOUD_INGEST_URL=

# Fluxo legado de sync direto. Não recomendado para multi-tenant.
# CHAMAAI_ALLOW_DIRECT_SUPABASE_SYNC=false

# URL base pública do portal do cliente (usada para gerar QR codes de ticket)
# Exemplo: https://portal.chamaai.com.br
CHAMAAI_PUBLIC_PORTAL_BASE_URL=

# URL do endpoint da Edge Function chamaai-portal utilizada pelo frontend Vite
# Exemplo: https://<id-projeto>.functions.supabase.co/chamaai-portal
VITE_CHAMAAI_PORTAL_API_URL=

# ==========================================
# COMANDOS REMOTOS SEGUROS (FASE 6)
# ==========================================
# Endpoint seguro para polling de comandos remotos (Edge Function chamaai-commands)
# Exemplo: https://<id-projeto>.functions.supabase.co/chamaai-commands
CHAMAAI_CLOUD_COMMANDS_URL=

# Intervalo em segundos para polling de novos comandos (padrão: 30)
CHAMAAI_CLOUD_COMMANDS_INTERVAL_SECONDS=30

# Habilitar recebimento legado de comandos direto via Supabase Realtime (não recomendado para produção)
CHAMAAI_ALLOW_LEGACY_SUPABASE_COMMANDS=false


